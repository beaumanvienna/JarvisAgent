{
  "version": "1.0",
  "id": "hamburg-tourist-day-planner",
  "label": "Hamburg Tourist Day Planner (n8n Integration Demo)",
  "doc": "Generates a weather-aware tourist day plan for Hamburg. Triggered externally via POST /api/webhook/hamburg-tourist-day-planner. Context variables (date, timezone, rainCategory, weatherJson) are injected into the AI prompt from the run context.",
  "manual_start": true,
  "triggers": [
    {
      "type": "webhook",
      "id": "webhook",
      "enabled": true,
      "params": {}
    }
  ],
  "defaults": {
    "timeout_ms": 120000
  },
  "tasks": {
    "plan": {
      "id": "plan",
      "type": "ai_call",
      "label": "Generate tourist day plan using weather context",
      "working_directory": "../queue/hamburg-tourist-day-planner/01_plan",
      "inputs": {
        "date":         { "type": "string", "required": true },
        "timezone":     { "type": "string", "required": true, "default": "Europe/Berlin" },
        "rainCategory": { "type": "string", "required": true },
        "weatherJson":  { "type": "string", "required": true }
      },
      "outputs": {
        "plan_markdown": { "type": "string" }
      },
      "queue_binding": {
        "stng_files": [
          {
            "path": "STNG_plan.txt",
            "content": "You write daily content for a tourist information kiosk in Hamburg, Germany. Output only raw Markdown. No markdown fences, no explanations, no preamble."
          }
        ],
        "task_files": [
          {
            "path": "TASK_plan.txt",
            "content": "Generate a full-day tourist itinerary for Hamburg. Include morning, afternoon, and evening activities. Adapt recommendations to the current weather:\n- no_rain: emphasize outdoor activities (parks, harbor walks, Elbphilharmonie plaza)\n- some_rain: mixed plan with short outdoor walks and indoor attractions\n- rain: focus on indoor attractions (museums, galleries, covered markets)\nDo NOT mention other cities. Hamburg only. Keep suggestions realistic."
          }
        ],
        "cntx_files": [
          {
            "path": "CNTX_weather.txt",
            "content": "Date: {{date}}\nTimezone: {{timezone}}\nRain category: {{rainCategory}}\nWeather forecast (raw JSON): {{weatherJson}}"
          }
        ],
        "prob_files": [
          {
            "path": "PROB_plan.txt",
            "content": "Generate the Hamburg tourist day plan for {{date}} as Markdown. Include the date in the first heading."
          }
        ]
      }
    }
  }
}
