{
  "version": "1.0",
  "id": "jarvisCppDocu",
  "label": "JarvisAgent C++ Docu Generator",
  "doc": [
    "Generates Markdown documentation for each C++ header (and matching .cpp when present) in application/ and engine/.",
    "Each task is an ai_call and writes its artifacts into a per-task folder under ../queue/<workflowId>/."
  ],
  "triggers": [
    {
      "type": "auto",
      "id": "auto-run",
      "enabled": true,
      "params": {}
    },
    {
      "type": "manual",
      "id": "manual-run",
      "enabled": true,
      "params": {
        "exposed_in_ui": true
      }
    }
  ],
  "tasks": {
    "doc_application_application_h": {
      "id": "doc_application_application_h",
      "type": "ai_call",
      "label": "Docu: application/application.h",
      "mode": "single",
      "working_directory": "../queue/jarvisCppDocu/01_doc_application_application_h",
      "file_inputs": [
        "../../../application/application.h"
      ],
      "file_outputs": [
        "docu.output.md"
      ],
      "queue_binding": {
        "stng_files": [
          {
            "path": "STNG_docu.txt",
            "content": "write consise, succinct, no guessing, no embelishments Do not wrap the output in triple-backtick code fences (no ```markdown). Output plain Markdown text only."
          }
        ],
        "task_files": [
          {
            "path": "TASK_docu.txt",
            "content": "Write a docu about this C++ class that helps humans and AIs to quickly and efficiently learn about what the function does."
          }
        ],
        "cntx_files": [
          "../../../application/application.h"
        ],
        "prob_files": [
          {
            "path": "PROB_docu.txt",
            "content": "Generate documentation for the provided C++ class. Output Markdown.\n"
          }
        ]
      }
    },
