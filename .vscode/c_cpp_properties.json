{
    "configurations": [
        {
            "name": "conf1",
            "compilerPath": "/usr/bin/g++",
            "includePath": [
                "${workspaceFolder}/application",
                "${workspaceFolder}/engine",
                "${workspaceFolder}/vendor",
                "${workspaceFolder}/vendor/spdlog/include",
                "${workspaceFolder}/vendor/curl/include",
                "${workspaceFolder}/vendor/thread-pool/include",
                "${workspaceFolder}/vendor/tracy/include",
                "${workspaceFolder}/vendor/openssl",
                "${workspaceFolder}/vendor/openssl/include",
                "${workspaceFolder}/vendor/openssl/providers/common/include",
                "${workspaceFolder}/vendor/openssl/providers/implementations/include",
                "${workspaceFolder}/vendor/openssl/providers/fips/include",
                "${workspaceFolder}/vendor/openssl/engines",
                "${workspaceFolder}/vendor/crow/include/crow",
                "${workspaceFolder}/vendor/asio/asio/include",
                "${workspaceFolder}/vendor/pdcursesmod",
                "${workspaceFolder}/vendor/date/include",
                "/usr/include/python3.12/",
                "/usr/include/c++/13",
                "/usr/include/x86_64-linux-gnu/c++/13",
                "/usr/include/c++/13/backward",
                "/usr/lib/gcc/x86_64-linux-gnu/13/include",
                "/usr/local/include",
                "/usr/include/x86_64-linux-gnu",
                "/usr/include"
            ],
            "defines": [
                "ZoneScopedNC(x,y)",
                "ZoneScopedN(x)",
                "ZoneTransientN(x, y, z)",
                "JARVIS_AGENT_VERSION"
            ],
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}