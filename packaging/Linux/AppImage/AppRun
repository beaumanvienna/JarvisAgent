#!/bin/bash
# AppRun — Entry point for the JarvisAgent AppImage.
#
# Creates a working directory at ~/JarvisAgent with symlinks
# to read-only assets inside the AppImage and real directories for writable
# data (queue/, log/, workflows/).

set -euo pipefail

APPDIR="$(dirname "$(readlink -f "$0")")"
DATA_DIR="${JARVISAGENT_DATA:-$HOME/JarvisAgent}"

# ---- Parse launcher-specific arguments ----
# Consume launcher-only flags here so they never reach the binary (which rejects
# unknown options and exits). --no-browser is accepted for parity with the
# system launcher; the AppImage opens no browser itself, so it is a no-op.
PASSTHROUGH_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --home)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --home requires a directory argument"
                exit 1
            fi
            DATA_DIR="$2"
            shift 2
            ;;
        --no-browser)
            shift
            ;;
        *)
            PASSTHROUGH_ARGS+=("$1")
            shift
            ;;
    esac
done

# ---- First-run setup ----
if [[ ! -d "$DATA_DIR" ]]; then
    echo "==> First run: creating working directory at $DATA_DIR"
    mkdir -p "$DATA_DIR"
fi

# Symlink read-only assets from AppImage into the working directory.
# Uses ln -sfn to atomically replace existing symlinks without rm.
# If a real directory already exists, skip it — content is there.
for asset in bin dashboard workflow-editor scripts doc; do
    if [[ -L "$DATA_DIR/$asset" ]] || [[ ! -e "$DATA_DIR/$asset" ]]; then
        ln -sfn "$APPDIR/usr/share/jarvisagent/$asset" "$DATA_DIR/$asset"
    fi
done

# Create writable directories if they don't exist
mkdir -p "$DATA_DIR/queue"
mkdir -p "$DATA_DIR/log"
mkdir -p "$DATA_DIR/workflows"

# Copy example workflows on first run
if [[ -d "$APPDIR/usr/share/jarvisagent/example-workflows" ]] && [[ -z "$(ls -A "$DATA_DIR/workflows" 2>/dev/null)" ]]; then
    cp -a "$APPDIR/usr/share/jarvisagent/example-workflows/"* "$DATA_DIR/workflows/" 2>/dev/null || true
    echo "==> Copied example workflows to $DATA_DIR/workflows/"
fi

# Copy example config on first run
if [[ ! -f "$DATA_DIR/config.json" ]]; then
    cp "$APPDIR/usr/share/jarvisagent/config.json.example" "$DATA_DIR/config.json"
    echo "==> Created $DATA_DIR/config.json from example — please edit it"
    echo "    (set API keys, adjust queue/workflow paths if needed)"
fi

# Note: the server mints its own self-signed TLS cert on first start when
# certs/j9t-{cert,key}.pem are absent (see WebServer::Start) — no launcher-side
# openssl provisioning is needed.

# ---- Python venv (first-run) ----
if [[ ! -d "$DATA_DIR/.venv" ]]; then
    echo "==> Creating Python virtual environment at $DATA_DIR/.venv ..."
    python3 -m venv "$DATA_DIR/.venv" 2>/dev/null || {
        echo "WARNING: Could not create Python venv (python3-venv may not be installed)"
        echo "         Shell tasks using markitdown/md2pdf will not work until fixed."
    }

    if [[ -d "$DATA_DIR/.venv" ]]; then
        "$DATA_DIR/.venv/bin/pip" install --quiet --upgrade pip 2>/dev/null || true
        echo "==> Installing Python tools (markitdown, md2pdf-mermaid, playwright) ..."
        "$DATA_DIR/.venv/bin/pip" install --quiet "markitdown[all]" md2pdf-mermaid playwright 2>/dev/null || true
        "$DATA_DIR/.venv/bin/playwright" install chromium 2>/dev/null || true
    fi
fi

# Activate venv if present
if [[ -f "$DATA_DIR/.venv/bin/activate" ]]; then
    source "$DATA_DIR/.venv/bin/activate"
fi

# ---- Launch ----
cd "$DATA_DIR"
exec "$DATA_DIR/bin/jarvisAgent-studio" "${PASSTHROUGH_ARGS[@]}"
