# Maintainer: JC Technolabs <https://github.com/beaumanvienna>
pkgname=jarvisagent-git
pkgver=0.1.r0.g0000000
pkgrel=1
pkgdesc="C++ backend / React frontend application for parallel AI-driven automation"
arch=('x86_64')
url="https://github.com/beaumanvienna/JarvisAgent"
license=('GPL-3.0-only')
depends=('python' 'python-pip' 'zlib' 'postgresql-libs' 'bash')
optdepends=('pandoc: PDF workflow support'
            'texlive-bin: PDF workflow support (pdflatex)'
            'nodejs: mermaid diagram rendering (mmdc)'
            'npm: mermaid diagram rendering (mmdc)')
makedepends=('git' 'base-devel' 'premake' 'nodejs' 'npm')
provides=('jarvisagent')
conflicts=('jarvisagent')
install=jarvisagent.install
source=("git+https://github.com/beaumanvienna/JarvisAgent.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/JarvisAgent"
    local _tag
    if _tag=$(git describe --long --tags 2>/dev/null); then
        echo "$_tag" | sed 's/^v//;s/-/.r/;s/-/./g'
    else
        local _ver=$(grep 'JARVIS_AGENT_VERSION' premake5.lua | sed 's/.*\\"\(.*\)\\".*$/\1/')
        printf "%s.r%s.g%s" "${_ver:-0.1}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

prepare() {
    cd "$srcdir/JarvisAgent"
    git submodule update --init --recursive
}

build() {
    cd "$srcdir/JarvisAgent"

    # Build Engine edition
    premake5 gmake --engine
    make -j$(nproc) config=release

    # Build Studio edition (default)
    premake5 gmake
    make -j$(nproc) config=release

    # Build React dashboard
    cd code/frontend/dashboard/ui
    npm install
    npm run build

    # Build React workflow editor
    cd ../../workflow-editor/ui
    npm install
    npm run build
}

package() {
    cd "$srcdir/JarvisAgent"

    local _instdir="$pkgdir/opt/jarvisagent"
    install -dm755 "$_instdir"

    # ---- Binaries (Studio + Engine) ----
    install -Dm755 bin/Release/jarvisAgent-studio "$_instdir/bin/jarvisAgent-studio"
    install -Dm755 bin/Release/jarvisAgent-engine "$_instdir/bin/jarvisAgent-engine"

    # ---- React UIs (pre-built dist/) ----
    install -dm755 "$_instdir/dashboard/ui"
    cp -r code/frontend/dashboard/ui/dist "$_instdir/dashboard/ui/dist"

    install -dm755 "$_instdir/workflow-editor/ui"
    cp -r code/frontend/workflow-editor/ui/dist "$_instdir/workflow-editor/ui/dist"

    # ---- Scripts (shell + Python, excluding __pycache__) ----
    cp -r scripts "$_instdir/scripts"
    find "$_instdir/scripts" -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    chmod +x "$_instdir/scripts/"*.sh

    # ---- Example workflows (curated list — no subdirs, no build artifacts) ----
    install -dm755 "$_instdir/workflows"
    for jcwf in aiCarMaintenancePipeline aiZipDemo \
                make-example portfolioDividendAnalysis \
                vehicleTroubleshootingGuide; do
        install -m644 "example/workflows/${jcwf}.jcwf" "$_instdir/workflows/"
    done
    # Loose input files are now bundled inside the .jcwf zip containers.

    # ---- Example config ----
    install -m644 packaging/config.json.example "$_instdir/config.json.example"

    # ---- Runtime directories (empty, created for the user) ----
    install -dm755 "$_instdir/queue"
    install -dm755 "$_instdir/log"

    # ---- Documentation ----
    install -dm755 "$_instdir/doc"
    install -m644 README.md "$_instdir/doc/README.md"
    install -m644 doc/JC_Workflow_Specification.md "$_instdir/doc/JC_Workflow_Specification.md" 2>/dev/null || true

    # ---- Man page ----
    install -Dm644 doc/jarvisagent.1 "$pkgdir/usr/share/man/man1/jarvisagent.1"
    gzip -9 "$pkgdir/usr/share/man/man1/jarvisagent.1"

    # ---- Launcher scripts (shared across deb/rpm/arch — detects edition from script name) ----
    install -Dm755 "$srcdir/JarvisAgent/packaging/Linux/jarvisagent-launcher.sh" "$pkgdir/usr/bin/jarvisagent"
    install -Dm755 "$srcdir/JarvisAgent/packaging/Linux/jarvisagent-launcher.sh" "$pkgdir/usr/bin/jarvisagent-engine"
    ln -sf jarvisagent "$pkgdir/usr/bin/jarvisagent-studio"
    ln -sf jarvisagent "$pkgdir/usr/bin/j9t"
}
