#!/usr/bin/make -f

export DH_VERBOSE = 1

DESTDIR  = debian/jarvisagent
INSTDIR  = $(DESTDIR)/opt/jarvisagent

%:
	dh $@

override_dh_auto_configure:
	# Build premake5 from bundled source (no network on Launchpad)
	cd vendor/premake-core && ./Bootstrap.sh

override_dh_auto_build:
	# Build Engine edition
	vendor/premake-core/bin/release/premake5 gmake --engine
	$(MAKE) -j$$(nproc) config=release
	# Build Studio edition (default)
	vendor/premake-core/bin/release/premake5 gmake
	$(MAKE) -j$$(nproc) config=release

override_dh_auto_install:
	# Binaries (Studio + Engine)
	install -dm755 $(INSTDIR)/bin
	install -Dm755 bin/Release/jarvisAgent-studio $(INSTDIR)/bin/jarvisAgent-studio
	install -Dm755 bin/Release/jarvisAgent-engine $(INSTDIR)/bin/jarvisAgent-engine

	# Pre-built React UIs (included in source tarball — no npm on Launchpad)
	install -dm755 $(INSTDIR)/dashboard/ui
	cp -r dashboard/ui/dist $(INSTDIR)/dashboard/ui/dist
	install -dm755 $(INSTDIR)/workflow-editor/ui
	cp -r workflow-editor/ui/dist $(INSTDIR)/workflow-editor/ui/dist

	# Scripts
	cp -r scripts $(INSTDIR)/scripts
	find $(INSTDIR)/scripts -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	chmod +x $(INSTDIR)/scripts/*.sh

	# Example workflows
	install -dm755 $(INSTDIR)/workflows
	for jcwf in aiCarMaintenancePipeline aiZipDemo exampleMakefile4 \
	            make-example portfolioDividendAnalysis \
	            vehicleTroubleshootingGuide; do \
	    cp example/workflows/$${jcwf}.jcwf $(INSTDIR)/workflows/ 2>/dev/null || true; \
	done
	# Loose input files are now bundled inside the .jcwf zip containers.

	# Config example
	install -m644 packaging/config.json.example $(INSTDIR)/config.json.example

	# Documentation
	install -dm755 $(INSTDIR)/doc
	install -m644 README.md $(INSTDIR)/doc/README.md
	install -m644 doc/JC_Workflow_Specification.md $(INSTDIR)/doc/JC_Workflow_Specification.md 2>/dev/null || true

	# Runtime directories
	install -dm755 $(INSTDIR)/queue
	install -dm755 $(INSTDIR)/log

	# Launcher scripts (shared across deb/rpm/arch — creates ~/JarvisAgent on first run)
	install -dm755 $(DESTDIR)/usr/bin
	install -Dm755 packaging/Linux/jarvisagent-launcher.sh $(DESTDIR)/usr/bin/jarvisagent
	install -Dm755 packaging/Linux/jarvisagent-launcher.sh $(DESTDIR)/usr/bin/jarvisagent-engine
	ln -sf jarvisagent $(DESTDIR)/usr/bin/jarvisagent-studio
	ln -sf jarvisagent $(DESTDIR)/usr/bin/j9t

override_dh_auto_test:
	# Skip tests

override_dh_strip:
	dh_strip --no-automatic-dbgsym || dh_strip
