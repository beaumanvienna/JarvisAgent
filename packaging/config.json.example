{
    "file format identifier": 1.2,
    "description": "jarvisAgent configuration file",
    "author": "Copyright (c) 2026 JC Technolabs",

    "queue folder": "queue",
    "workflows folder": "workflows",
    "max threads": 20,
    "engine sleep time in run loop in ms": 16,
    "verbose": false,
    "port": 8443,

    "API interfaces": [
        {
            "name": "api.openai.com/gpt-4.1/API1",
            "description": "High-accuracy model with strong reasoning. Use for precise technical tasks, debugging, and complex questions. Use API index 0.",
            "url": "https://api.openai.com/v1/chat/completions",
            "model": "gpt-4.1",
            "API": "API1",
            "key_name": "openai"
        },
        {
            "name": "api.openai.com/gpt-5-nano/API2",
            "description": "Ultra-fast and extremely low-cost model. Ideal for large document batches, chunked PDF processing, and high-volume workloads. Use API index 1.",
            "url": "https://api.openai.com/v1/responses",
            "model": "gpt-5-nano",
            "API": "API2",
            "key_name": "openai"
        },
        {
            "name": "api.openai.com/gpt-4.1-mini/API1",
            "description": "Lightweight, inexpensive model. Suitable for quick rewrites, smaller tasks, and general utility work. Use API index 2.",
            "url": "https://api.openai.com/v1/chat/completions",
            "model": "gpt-4.1-mini",
            "API": "API1",
            "key_name": "openai"
        },
        {
            "name": "api.openai.com/gpt-4.1-mini/API2",
            "description": "Same model as gpt-4.1-mini, but via the Responses API for faster throughput when processing sequential chunks. Use API index 3.",
            "url": "https://api.openai.com/v1/responses",
            "model": "gpt-4.1-mini",
            "API": "API2",
            "key_name": "openai"
        },
        {
            "name": "Google Gemini (OpenAI Legacy)",
            "description": "Google Gemini 2.5 Flash via OpenAI-compatible endpoint. OPENAI LEGACY interface. Use API index 4.",
            "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
            "model": "gemini-2.5-flash",
            "API": "API1",
            "key_name": "google"
        },
        {
            "name": "Google Gemini (Native)",
            "description": "Google Gemini 2.5 Flash Lite via native GEMINI interface. Uses x-goog-api-key auth and /models/{model}:generateContent URL. Use API index 5.",
            "url": "https://generativelanguage.googleapis.com/v1beta",
            "model": "gemini-2.5-flash-lite",
            "API": "API3",
            "key_name": "google"
        },
        {
            "name": "api.openai.com/gpt-4.1/MAX",
            "description": "Maximum reasoning quality. Slowest and most expensive option. Use for hardest problems, architecture design, and critical debugging. Use API index 6.",
            "url": "https://api.openai.com/v1/chat/completions",
            "model": "gpt-4.1",
            "API": "API1",
            "key_name": "openai"
        }
    ],

    "API index": 6,
    "max file size in kB": 24,
    "jcwf batch size": 1,
    "jcwf AI interface": -1,
    "use_bash": false,

    "TlsCert": "certs/j9t-cert.pem",
    "TlsKey": "certs/j9t-key.pem"
}
