{
    "file format identifier": 1.2,
    "description": "jarvisAgent configuration file",
    "author": "Copyright (c) 2026 JC Technolabs",

    "queue folder": "queue",
    "workflows folder": "workflows",
    "max threads": 20,
    "engine sleep time in run loop in ms": 16,
    "verbose": false,
    "port": 8443,

    "max file size in kB": 24,
    "jcwf batch size": 1,
    "use_bash": false,

    "keys_file": "keys.json.enc",
    "mcp_keys_file": "mcp_keys.json.enc",
    "api_file": "API.json.enc",
    "connections_file": "connections.json.enc",

    "TlsCert": "certs/j9t-cert.pem",
    "TlsKey": "certs/j9t-key.pem"
}
